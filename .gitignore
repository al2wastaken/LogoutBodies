# Track only production sources, runtime resources, build tooling and repository metadata.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat

!/gradle/
/gradle/*
!/gradle/wrapper/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

!/api/
!/core/
!/platform-common/
!/platform-1_21_11/
!/platform-26_1_2/
!/platform-26_2/
/api/*
/core/*
/platform-*/*
!/*/build.gradle.kts
!/*/src/
/*/src/*
!/*/src/main/

# Documentation, tests and local/generated files stay on disk but outside Git.
*.md
*.markdown
**/src/test/
**/build/
**/.gradle/
**/node_modules/
*.class
*.log
hs_err_pid*
replay_pid*

# Contributor instructions are the sole tracked Markdown exception.
!/AGENTS.md
